{
  "info": {
    "name": "User Service - IAE",
    "_postman_id": "user-service-iae-collection",
    "description": "Postman collection for user-service (REST + GraphQL)\nBase URL: http://localhost:8001\n\nAuth: Bearer token (dari response login/register)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Bearer token dari response login atau register"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            },
            "description": "Cek apakah user-service berjalan"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.environment.set('token', json.token);",
                  "    pm.environment.set('user_id', String(json.user.id));",
                  "    console.log('Token saved:', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Adhelia Ayu\",\n  \"email\": \"adhelia@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": ["{{base_url}}"],
              "path": ["api", "register"]
            },
            "description": "Register user baru. Token otomatis tersimpan ke environment variable."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.environment.set('token', json.token);",
                  "    pm.environment.set('user_id', String(json.user.id));",
                  "    console.log('Token saved:', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"adhelia@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            },
            "description": "Login user. Token otomatis tersimpan ke environment variable."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "logout"]
            },
            "description": "Logout dan revoke token. Butuh Bearer token."
          },
          "response": []
        },
        {
          "name": "Me (Get Current User)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/me",
              "host": ["{{base_url}}"],
              "path": ["api", "me"]
            },
            "description": "Ambil data user yang sedang login. Butuh Bearer token."
          },
          "response": []
        },
        {
          "name": "My Order Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/me/order-summary",
              "host": ["{{base_url}}"],
              "path": ["api", "me", "order-summary"]
            },
            "description": "Ambil ringkasan order milik user yang sedang login. Butuh Bearer token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users (CRUD)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": ["{{base_url}}"],
              "path": ["api", "users"]
            },
            "description": "Ambil semua user. Tidak butuh auth."
          },
          "response": []
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "{{user_id}}"]
            },
            "description": "Ambil detail user berdasarkan ID."
          },
          "response": []
        },
        {
          "name": "Create User (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User Baru\",\n  \"email\": \"userbaru@example.com\",\n  \"password\": \"password123\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": ["{{base_url}}"],
              "path": ["api", "users"]
            },
            "description": "Buat user baru (admin). is_active opsional, default true."
          },
          "response": []
        },
        {
          "name": "Update User (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nama Baru\",\n  \"email\": \"emailbaru@example.com\",\n  \"password\": \"newpassword123\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "{{user_id}}"]
            },
            "description": "Update data user (full update). Semua field opsional."
          },
          "response": []
        },
        {
          "name": "Update User (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nama Diupdate\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "{{user_id}}"]
            },
            "description": "Update sebagian data user (partial update)."
          },
          "response": []
        },
        {
          "name": "Update User Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "{{user_id}}", "status"]
            },
            "description": "Aktifkan atau nonaktifkan user. Jika dinonaktifkan, token akan direvoke."
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "{{user_id}}"]
            },
            "description": "Hapus user berdasarkan ID. Token user akan direvoke."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Orders",
      "item": [
        {
          "name": "Get User Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "{{user_id}}", "orders"]
            },
            "description": "Ambil semua order milik user. Data diambil dari order-service."
          },
          "response": []
        },
        {
          "name": "Get User Order Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}/order-summary",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "{{user_id}}", "order-summary"]
            },
            "description": "Ambil ringkasan statistik order user (total, spent, dll)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "GraphQL",
      "item": [
        {
          "name": "[Query] Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { login(email: \\\"adhelia@example.com\\\", password: \\\"password123\\\") { user { id name email is_active } token token_type } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Login via GraphQL query."
          },
          "response": []
        },
        {
          "name": "[Query] Me",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { me(token: \\\"{{token}}\\\") { id name email is_active created_at } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Ambil data user berdasarkan token (token dikirim sebagai argument, bukan header)."
          },
          "response": []
        },
        {
          "name": "[Query] Get All Users (Paginated)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { users(first: 10, page: 1) { data { id name email is_active created_at } current_page per_page total } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Ambil semua user dengan pagination."
          },
          "response": []
        },
        {
          "name": "[Query] Get User by ID",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { user(id: 1) { id name email is_active created_at updated_at } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Ambil detail user berdasarkan ID."
          },
          "response": []
        },
        {
          "name": "[Query] User With Orders",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { userWithOrders(id: 1) { user { id name email } orders { id food_name quantity total_price status created_at } } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Ambil user beserta daftar order-nya dari order-service."
          },
          "response": []
        },
        {
          "name": "[Query] User Order Summary",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { userOrderSummary(id: 1) { user { id name email } summary { total_orders total_spent average_order_value active_orders completed_orders failed_orders cancelled_orders status_breakdown { status count } } } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Ambil ringkasan statistik order user via GraphQL."
          },
          "response": []
        },
        {
          "name": "[Mutation] Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.registerUser && json.data.registerUser.token) {",
                  "    pm.collectionVariables.set('token', json.data.registerUser.token);",
                  "    pm.collectionVariables.set('user_id', json.data.registerUser.user.id);",
                  "    console.log('GraphQL token saved:', json.data.registerUser.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { registerUser(name: \\\"Adhelia Ayu\\\", email: \\\"adhelia@example.com\\\", password: \\\"password123\\\") { user { id name email is_active } token token_type } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Register user baru via GraphQL. Token otomatis tersimpan ke collection variable."
          },
          "response": []
        },
        {
          "name": "[Mutation] Create User (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { createUser(name: \\\"User Baru\\\", email: \\\"userbaru@example.com\\\", password: \\\"password123\\\", is_active: true) { id name email is_active created_at } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Buat user baru (admin) via GraphQL."
          },
          "response": []
        },
        {
          "name": "[Mutation] Update User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { updateUser(id: 1, name: \\\"Nama Baru\\\", email: \\\"emailbaru@example.com\\\") { id name email is_active updated_at } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Update data user. Semua field selain id bersifat opsional."
          },
          "response": []
        },
        {
          "name": "[Mutation] Update User Status",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { updateUserStatus(id: 1, is_active: false) { id name email is_active } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Aktifkan/nonaktifkan user. Jika dinonaktifkan, token akan direvoke."
          },
          "response": []
        },
        {
          "name": "[Mutation] Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { logout(token: \\\"{{token}}\\\") { success message } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Logout via GraphQL. Token dikirim sebagai argument."
          },
          "response": []
        },
        {
          "name": "[Mutation] Delete User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { deleteUser(id: 1) { success message } }\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "description": "Hapus user via GraphQL. Token user juga akan direvoke."
          },
          "response": []
        }
      ]
    }
  ]
}
